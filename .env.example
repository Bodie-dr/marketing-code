# Kopieer dit bestand naar .env en vul je eigen sleutels in.
# .env staat in .gitignore en mag NOOIT gecommit worden.

# Tekstgenerator (Azure OpenAI)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=

# Kennisbank
DOCUMENTS_FOLDER=
PROJECT_NAME=marketing_AI

# Kalender-automatisering (leeg = kopie in calander_automatisering/)
CALENDAR_EXCEL_FILE=

# Foto-generatie
CLAID_API_KEY=
CLAID_UPLOAD_URL=https://api.claid.ai/v1/image/edit/upload
PIXELCUT_API_KEY=

# Cloudinary (nog niet in gebruik)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
